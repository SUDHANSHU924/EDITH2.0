# ════════════════════════════════════════════════════════
# EDITH 2.0 — PRODUCTION STACK CONFIGURATION
# ════════════════════════════════════════════════════════

# ── AI MODELS ───────────────────────────────────────────
# NVIDIA (DeepSeek R1 - Main Brain)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_MAIN=deepseek-ai/deepseek-r1
NVIDIA_MODEL_CODE=deepseek-ai/deepseek-coder-v2

# Groq (LLaMA Fallback - Fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace (Vision & Embeddings)
HUGGINGFACE_API_KEY=
HF_VISION_MODEL=OpenGVLab/InternVL2-8B
HF_EMBED_MODEL=BAAI/bge-m3

# ── SEARCH & RESEARCH ───────────────────────────────────
TAVILY_API_KEY=

# ── DATABASE ────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
REDIS_URL=redis://localhost:6379
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── FRONTEND ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── BACKEND ─────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
PORT=8000

# ── SECURITY (System 14 - Hacker Mode) ──────────────────
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
ALIENVAULT_OTX_KEY=
HACKER_MODE_TOKEN=

# ── SATELLITE (System 15) ───────────────────────────────
N2YO_API_KEY=
NASA_API_KEY=
ESA_SENTINEL_KEY=
SPACETRACK_USER=
SPACETRACK_PASS=
